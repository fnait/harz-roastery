# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# Firebase Admin SDK (path to the service account JSON, kept outside Git)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# Firebase Storage bucket for product images (required at startup)
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket

# Firebase Authentication UID of the only user allowed to use the admin API
ADMIN_UID=your_firebase_admin_uid

# DeepL API (used by the admin panel to translate UK -> EN)
DEEPL_API_KEY=your_deepl_api_key

# Product image storage: "firebase" (Firebase Storage) or "cloudinary"
IMAGE_STORAGE_PROVIDER=firebase

# Cloudinary (only needed when IMAGE_STORAGE_PROVIDER=cloudinary
# or to delete product images that were uploaded to Cloudinary earlier)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Telegram (notifications about new orders and requests)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
